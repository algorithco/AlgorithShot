{
  "name": "@algorithco/shot-desktop",
  "private": true,
  "license": "MIT",
  "description": "Offline screenshots, OCR search and privacy tools for Windows, macOS and Linux",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/algorithco/AlgorithShot.git",
    "directory": "desktop"
  },
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare-ocr.mjs && vite",
    "build": "node scripts/prepare-ocr.mjs && tsc && vite build",
    "build:local": "node scripts/build-local.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:ocr": "node --test scripts/ocr.test.mjs",
    "typecheck": "tsc --noEmit",
    "release:build": "node scripts/build-release.mjs",
    "release:build:unsigned": "node scripts/build-platform.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "test:release": "node --test scripts/release.test.mjs"
  },
  "dependencies": {
    "@crabnebula/tauri-plugin-drag": "^2.1.0",
    "@tanstack/react-virtual": "^3.14.22",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-autostart": "~2.7.0",
    "@tauri-apps/plugin-dialog": "~2.8.3",
    "@tauri-apps/plugin-global-shortcut": "~2",
    "@tauri-apps/plugin-log": "~2.10.1",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "~2.3.1",
    "@tauri-apps/plugin-updater": "~2.11.0",
    "lucide-react": "^1.61.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tesseract.js": "6.0.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.5"
  }
}
