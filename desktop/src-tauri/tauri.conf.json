{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AlgorithShot",
  "version": "0.2.0",
  "identifier": "com.algorithco.shot",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "img-src": "'self' data: blob: shot: http://shot.localhost",
        "connect-src": "'self' ipc: shot: http://ipc.localhost http://shot.localhost",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "worker-src": "'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "publisher": "Algorithco",
    "copyright": "Copyright © 2026 Algorithco and contributors",
    "license": "MIT",
    "licenseFile": "../../LICENSE",
    "category": "Productivity",
    "shortDescription": "Screenshots that are exact, searchable and safe to share",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "template": "windows/installer.nsi",
        "installerHooks": "windows/theme.nsh",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "languages": ["English", "Uzbek", "Russian"],
        "customLanguageFiles": {
          "English": "windows/languages/English.nsh",
          "Uzbek": "windows/languages/Uzbek.nsh",
          "Russian": "windows/languages/Russian.nsh"
        },
        "displayLanguageSelector": false,
        "compression": "lzma"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNCNjVEMTgyQjJBNzNEMTkKUldRWlBhZXlndEZsTy94eWI1L0t6WG01eGVwNklyQXlPVEdQNURwUTBVcjE4UklNL3pybHZUZ2MK",
      "endpoints": [
        "https://github.com/algorithco/algorith-shot-releases/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
