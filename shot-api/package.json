{
  "name": "@algorithco/shot-api",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "The independent AlgorithShot HTTP API",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/algorithco/AlgorithShot.git",
    "directory": "shot-api"
  },
  "type": "module",
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/swagger": "9.9.2",
    "@fastify/swagger-ui": "6.1.2",
    "fastify": "^5.12.7"
  },
  "devDependencies": {
    "@types/node": "~24.13.6",
    "typescript": "~7.0.2"
  }
}
