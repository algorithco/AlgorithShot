{
  "name": "@algorithco/shot-api",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "The independent AlgorithShot HTTP API",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/algorithco/AlgorithShot.git",
    "directory": "shot-api"
  },
  "type": "module",
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "test:redis": "node --test test/redis.test.ts",
    "smoke": "node scripts/smoke.mjs",
    "smoke:container": "node scripts/container-smoke.mjs",
    "account:check": "node --env-file-if-exists=.env scripts/check-account.ts"
  },
  "files": ["dist", "README.md", "docs", "integration"],
  "dependencies": {
    "@fastify/cors": "^11.4.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "9.9.3",
    "@fastify/swagger-ui": "6.1.3",
    "fastify": "^5.12.8",
    "ioredis": "5.8.1",
    "jose": "6.2.15"
  },
  "devDependencies": {
    "@types/node": "~24.13.6",
    "typescript": "~6.0.3"
  }
}
