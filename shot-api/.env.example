# Local development. Production requires explicit HTTPS Account URLs and Redis.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
DOCS_ENABLED=true
# Exact trusted proxy hop count. 0 ignores all forwarded headers.
TRUST_PROXY=0
# Exact origins only. Native Rust HTTP clients do not require CORS permission.
CORS_ORIGINS=http://localhost:1420,http://127.0.0.1:1420,http://tauri.localhost,tauri://localhost

# Confirm the canonical deployment URLs when configuring central Account.
# Billing/license routes live at the host root, NOT under /account.
ACCOUNT_ISSUER=https://algorithco.trqsh.uz/account
ACCOUNT_API_BASE_URL=https://algorithco.trqsh.uz
ACCOUNT_WEB_URL=https://algorithco.trqsh.uz
ACCOUNT_AUDIENCE=algorithco-platform-api
ACCOUNT_CLIENT_IDS=shot-desktop
ACCOUNT_TIMEOUT_MS=5000
ACCOUNT_METADATA_CACHE_MS=600000
ACCOUNT_JWKS_COOLDOWN_MS=30000
ACCOUNT_CLOCK_TOLERANCE_SECONDS=5

# Maximum accepted signed license lifetime; central Shot policy must match.
# Keys are fetched PUBLIC keys. No private signing key belongs in Shot API.
LICENSE_AUDIENCE=algorithco-products
OFFLINE_MAX_AGE_SECONDS=604800
OFFLINE_REFRESH_AFTER_SECONDS=86400

# Redis is optional for local development and mandatory in production.
# Use rediss:// for managed Redis with TLS. Never commit the real URL/password.
REDIS_URL=
RATE_LIMIT_NAMESPACE=shot-api:rate:
RATE_LIMIT_MAX=120
LICENSE_RATE_LIMIT_MAX=5

# Used by infra/compose.yaml only. Supply a random URL-safe password and set
# REDIS_URL=redis://:<percent-encoded-password>@redis:6379/0 in the real .env.
SHOT_REDIS_PASSWORD=
SHOT_API_PORT=3000
